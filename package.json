{
  "name": "revotech-asset-tag",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite build && wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "hash": "node scripts/hash-password.mjs",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "deploy": "vite build && wrangler deploy",
    "seed:dev": "node scripts/seed-dev.mjs && wrangler d1 execute DB --local --file .wrangler/seed-dev.sql"
  },
  "dependencies": {
    "hono": "^4.13.22",
    "maplibre-gl": "^6.19.0",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@maplibre/maplibre-gl-style-spec": "^26.9.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
