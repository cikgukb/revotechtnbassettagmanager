{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revotech-asset-tag",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revotech-asset-tag-db",
      "database_id": "b4b8b837-dbe3-4409-87a1-a946578975a3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "revotech-asset-tag-photos" }
  ],
  "observability": { "enabled": true }
}
